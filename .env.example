## Copia este archivo como .env y completa los valores. .env NO se versiona.

## Perfil de Spring Boot: dev (Testcontainers) o prod (PostgreSQL externo)
SPRING_PROFILE=prod
SERVER_PORT=8080

## PostgreSQL (solo perfil prod; en dev lo levanta Testcontainers)
BD_URL=jdbc:postgresql://localhost:5432/postgres
BD_USERNAME=postgres
BD_PASSWORD=
BD_SCHEMA=jobsi

## CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

## JWT (minimo 32 caracteres; obligatorio en prod)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

## Administrador inicial (se crea al arrancar si no existe un usuario con ese correo)
ADMIN_DOCUMENTO=1000000000
ADMIN_NOMBRE=Administrador
ADMIN_PRIMER_APELLIDO=Jobsi
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TELEFONO=3000000000
ADMIN_FECHA_NACIMIENTO=2000-01-01

## Correo SMTP (recuperacion de contrasena)
## Mailpit local: MAIL_HOST=localhost MAIL_PORT=1025 sin autenticacion
## Gmail: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_SMTP_AUTH=true MAIL_STARTTLS=true
##        y MAIL_PASSWORD = contrasena de aplicacion de Google
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@jobsi.local
PASSWORD_RESET_EXPIRATION=30

## URLs publicas
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
